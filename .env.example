# Copy to .env. Never commit .env.
POSTGRES_PASSWORD = replace_with_a_long_random_password
JWT_SECRET = replace_with_a_random_secret_at_least_32_characters
ADMIN_EMAIL = admin@example.com

# Generate using: node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(console.log)" 
# (run in backend/ after npm install)
# IMPORTANT: In .env, escape dollar signs in this bcrypt hash as $$ when using Docker Compose.
ADMIN_PASSWORD_HASH = replace_with_bcrypt_hash
FRONTEND_ORIGIN = http://localhost:8080
NODE_ENV = development
